    "import os\n",
    "import django\n",
    "\n",
    "# 장고 설정 파일(config.settings)을 가져옵니다.\n",
    "os.environ.setdefault('DJANGO_SETTINGS_MODULE', 'config.settings')\n",
    "os.environ[\"DJANGO_ALLOW_ASYNC_UNSAFE\"] = \"true\"\n",
    "django.setup()\n",
    "\n",
